export https_proxy=http://47.84.5.93:8415

conda install python=3.12 -q -y

if [ $(uname) == "Darwin" ]; then
curl -fsSL https://github.com/coder/code-server/releases/download/v4.107.0/code-server-4.107.0-macos-arm64.tar.gz | tar -xzvf - -C $CONDA_PREFIX
CODE_SERVER_PATH=$CONDA_PREFIX/code-server-4.107.0-macos-arm64; else
curl -fsSL https://github.com/coder/code-server/releases/download/v4.107.0/code-server-4.107.0-linux-amd64.tar.gz | tar -xzvf - -C $CONDA_PREFIX
CODE_SERVER_PATH=$CONDA_PREFIX/code-server-4.107.0-linux-amd64; fi

rm -rf $CONDA_PREFIX/lib/code-server-4.107.0
mv $CODE_SERVER_PATH $CONDA_PREFIX/lib/code-server-4.107.0
CODE_EXEC=$CONDA_PREFIX/lib/code-server-4.107.0/bin/code-server
ln -sf $CODE_EXEC $CONDA_PREFIX/bin/code-server